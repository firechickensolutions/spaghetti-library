# Shower Thoughts — optional config. Copy to .env or set in your environment.
# Every value has a sensible default; nothing here is required.

# Where notes are written. Point this at an Obsidian vault subfolder to make
# your captures part of an existing vault.
# SHOWER_CAPTURE_VAULT_PATH=C:\Users\you\ShowerThoughts

# STT model + providers. CPU is the default (~13x real-time, no GPU needed).
# For GPU: install .[gpu] and set providers to CUDA first.
# SHOWER_PARAKEET_MODEL=nemo-parakeet-tdt-0.6b-v3
# SHOWER_PARAKEET_PROVIDERS=CPUExecutionProvider
# SHOWER_PARAKEET_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider

# Long-capture safety window (seconds) for the chunked decoder.
# SHOWER_PARAKEET_MAX_DECODE_SECONDS=180

# Local LLM (Ollama) models for the enrich + index step.
# SHOWER_THOUGHT_LLM_MODEL=qwen2.5:7b
# SHOWER_THOUGHT_EMBED_MODEL=nomic-embed-text

# Your coined-names vocab file (defaults to <vault>/.library/vocab.json).
# SHOWER_THOUGHT_VOCAB_PATH=
